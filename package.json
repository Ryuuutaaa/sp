{
  "name": "sp",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"data,backend,web,studio\" --prefix-colors \"green,yellow,cyan,magenta\" \"pnpm dev:data\" \"pnpm dev:backend\" \"pnpm dev:web\" \"pnpm dev:studio\"",
    "dev:data": "pnpm --filter data-service dev",
    "dev:backend": "sh -c 'cd backend && go run ./cmd/api/main.go'",
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter data-service studio",
    "dev:full": "pnpm dev & pnpm dev:studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "wait-on": "^9.1.0"
  }
}
